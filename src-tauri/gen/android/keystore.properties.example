# Android 发布签名配置。
# 复制本文件为 keystore.properties 并填写（keystore.properties 已在 .gitignore 中，不要提交）。
# 也可以改用环境变量：ANDROID_KEYSTORE_PATH、ANDROID_KEYSTORE_PASSWORD、ANDROID_KEY_ALIAS、ANDROID_KEY_PASSWORD

# keystore 文件的绝对路径
storeFile=/path/to/chmlfrp-release.jks
storePassword=
keyAlias=chmlfrp
# 生成时直接回车（与密钥库口令相同）的话，这一项可以留空
keyPassword=
