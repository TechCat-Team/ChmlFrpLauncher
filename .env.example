# Windows 发布脚本（pnpm release:windows）使用的环境变量。
# 复制本文件为 .env 后填写真实值；.env 已加入 .gitignore，不要提交。
# 优先级：命令行参数 > 已设置的系统环境变量 > .env

# ChmlFrp 内核源码目录，相对路径以项目根目录为基准
CHMLFRP_SOURCE_DIR=C:\path\to\frp

# 代码签名证书的 SHA1 指纹（40 位十六进制）
WINDOWS_CERT_SHA1=YOUR_CERT_SHA1_THUMBPRINT
# 时间戳服务器，可不填，默认 http://timestamp.sectigo.com
WINDOWS_TIMESTAMP_URL=http://timestamp.sectigo.com

# Tauri 自动更新签名密钥（不是代码签名证书）。二选一：
# 1) 密钥文件路径
TAURI_SIGNING_PRIVATE_KEY_PATH=C:\path\to\tauri-update.key
# 2) 直接填密钥内容（填了这个就不用上面的路径）
# TAURI_SIGNING_PRIVATE_KEY=
# 密钥有密码时填写
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
